		"devdoc": {
			"kind": "dev",
			"methods": {
				"checkVaccinationStatus(address,uint256)": {
					"details": "Check if a user has a verified vaccine proof for a specific vaccine code."
				},
				"getVaccinationDetails(address,uint256)": {
					"details": "Get full vaccination verification details."
				},
				"isCommitmentRegistered(address,uint256)": {
					"details": "Check if a commitment has been registered by a user."
				},
				"registerVaccineCommitment(uint256)": {
					"details": "Register a Poseidon commitment for a vaccination record.      Call this immediately after adding a vaccination record.      commitment = poseidon(vaccinationId, vaccineName, salt) — computed on-device",
					"params": {
						"commitment": "The Poseidon hash to register on-chain"
					}
				},
				"submitVaccineProof(uint256[2],uint256[2][2],uint256[2],uint256[3])": {
					"details": "Submit a ZK proof to prove vaccination for a specific vaccine.",
					"params": {
						"a": "Groth16 proof component A",
						"b": "Groth16 proof component B",
						"c": "Groth16 proof component C",
						"input": "Public signals:                 [0] = isVaccinated  (must be 1)                 [1] = commitment    (must be registered by msg.sender)                 [2] = targetVaccine (1-14)"
					}
				}
			},
